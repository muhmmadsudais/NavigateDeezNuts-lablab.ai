# Copy to .env and fill in. Everything is optional: with no API key the app
# runs in "AI: offline fallback" mode using deterministic templates.

# Vultr Serverless Inference API key (Vultr portal > Products > Serverless Inference)
VULTR_API_KEY=

# OpenAI-compatible endpoint (default shown)
VULTR_BASE_URL=https://api.vultrinference.com/v1

# Optional: exact model id. Leave empty to auto-pick a llama/qwen/mistral instruct model.
VULTR_MODEL=
